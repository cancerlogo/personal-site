---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
  category?: string;
  tags?: string[];
  readingTime?: string;
}

const { title, description, pubDate, slug, category, tags = [], readingTime } = Astro.props;

const dateStr = pubDate.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
---

<article class="card-glow rounded-lg p-6 bg-bg-card hover:-translate-y-1 transition-all duration-300">
  <a href={`/blog/${slug}`} class="block">
    <h3 class="text-lg font-semibold text-text-primary mb-2 hover:text-accent transition-colors">
      {title}
    </h3>
    <p class="text-text-secondary text-sm mb-4 line-clamp-2">{description}</p>
    <div class="flex items-center gap-3 text-xs text-text-secondary">
      <time datetime={pubDate.toISOString()}>{dateStr}</time>
      {category && (
        <span class="px-2 py-0.5 rounded-full bg-accent/10 text-accent">{category}</span>
      )}
      {readingTime && <span>{readingTime}</span>}
    </div>
    {tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5 mt-3">
        {tags.slice(0, 3).map((tag) => (
          <span class="text-xs px-2 py-0.5 rounded bg-bg-primary text-text-secondary">
            #{tag}
          </span>
        ))}
      </div>
    )}
  </a>
</article>
