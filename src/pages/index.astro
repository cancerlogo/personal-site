---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const projects = (await getCollection('projects'))
  .filter((project) => project.data.featured)
  .slice(0, 4);

function getReadingTime(content: string): string {
  const chineseChars = (content.match(/[一-鿿]/g) || []).length;
  const englishWords = (content.match(/[a-zA-Z]+/g) || []).length;
  const minutes = Math.ceil(chineseChars / 400 + englishWords / 200);
  return `${minutes} 分钟`;
}
---

<BaseLayout title="首页">
  {/* Hero Section */}
  <section class="text-center py-16">
    <div class="mb-6">
      <div class="w-24 h-24 mx-auto rounded-full bg-accent/20 flex items-center justify-center text-4xl">
        👋
      </div>
    </div>
    <h1 class="text-4xl font-bold mb-4">你好，我是 [Your Name]</h1>
    <p class="text-text-secondary text-lg max-w-2xl mx-auto mb-8">
      热爱技术的开发者，专注于 Web 开发和开源项目。这里是我的个人空间，记录学习与创造的过程。
    </p>
    <div class="flex justify-center gap-4">
      <a href="https://github.com/xxx" target="_blank" rel="noopener noreferrer" class="px-6 py-2 rounded-full border border-accent text-accent hover:bg-accent/10 transition-colors">
        GitHub
      </a>
      <a href="mailto:xxx@example.com" class="px-6 py-2 rounded-full bg-accent text-bg-primary hover:opacity-90 transition-opacity">
        联系我
      </a>
    </div>
  </section>

  {/* Latest Posts */}
  <section class="py-12">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-2xl font-bold">最新文章</h2>
      <a href="/blog" class="text-accent text-sm hover:underline">查看全部 →</a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {posts.map((post) => (
        <BlogCard
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          slug={post.id}
          category={post.data.category}
          tags={post.data.tags}
          readingTime={getReadingTime(post.body || '')}
        />
      ))}
    </div>
  </section>

  {/* Featured Projects */}
  <section class="py-12">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-2xl font-bold">精选项目</h2>
      <a href="/projects" class="text-accent text-sm hover:underline">查看全部 →</a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {projects.map((project) => (
        <ProjectCard
          name={project.data.name}
          description={project.data.description}
          techStack={project.data.techStack}
          github={project.data.github}
          demo={project.data.demo}
        />
      ))}
    </div>
  </section>
</BaseLayout>
