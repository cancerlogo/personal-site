---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="关于">
  <div class="max-w-3xl mx-auto">
    <h1 class="text-3xl font-bold mb-8 animate-fade-in-up">关于我</h1>

    {/* Introduction */}
    <section class="mb-12 animate-fade-in-up stagger-1">
      <div class="flex flex-col md:flex-row gap-8 items-start">
        <div class="w-32 h-32 rounded-full bg-accent/20 flex items-center justify-center text-5xl shrink-0 animate-float">
          👨‍💻
        </div>
        <div>
          <p class="text-lg text-text-primary mb-4">
            你好！我是 cancerlogo，一名热爱技术的开发者。
          </p>
          <p class="text-text-secondary">
            我喜欢探索新技术，解决复杂问题，并通过代码创造有价值的工具。这个网站是我的个人空间，用来记录学习笔记、分享项目经验。
          </p>
        </div>
      </div>
    </section>

    {/* Skills */}
    <section class="mb-12 reveal">
      <h2 class="text-2xl font-bold mb-4">技能</h2>
      <div class="flex flex-wrap gap-2">
        {['JavaScript', 'TypeScript', 'React', 'Vue', 'Node.js', 'Python', 'Docker', 'Git', 'Linux'].map((skill) => (
          <span class="tag-hover px-3 py-1.5 rounded-lg bg-bg-card border border-border text-text-primary text-sm cursor-pointer">
            {skill}
          </span>
        ))}
      </div>
    </section>

    {/* Experience */}
    <section class="mb-12 reveal">
      <h2 class="text-2xl font-bold mb-6">经历</h2>
      <div class="space-y-6">
        <div class="relative pl-6 border-l-2 border-accent group">
          <div class="absolute w-3 h-3 bg-accent rounded-full -left-[7px] top-1 group-hover:scale-150 transition-transform duration-300"></div>
          <h3 class="font-semibold text-text-primary group-hover:text-accent transition-colors duration-300">高级前端工程师</h3>
          <p class="text-text-secondary text-sm mb-1">某科技公司 · 2024 - 至今</p>
          <p class="text-text-secondary text-sm">负责核心产品前端架构设计与开发</p>
        </div>
        <div class="relative pl-6 border-l-2 border-border group">
          <div class="absolute w-3 h-3 bg-border rounded-full -left-[7px] top-1 group-hover:scale-150 transition-transform duration-300"></div>
          <h3 class="font-semibold text-text-primary group-hover:text-accent transition-colors duration-300">前端开发工程师</h3>
          <p class="text-text-secondary text-sm mb-1">某互联网公司 · 2022 - 2024</p>
          <p class="text-text-secondary text-sm">参与多个 Web 项目的开发与维护</p>
        </div>
      </div>
    </section>

    {/* Contact */}
    <section class="reveal">
      <h2 class="text-2xl font-bold mb-4">联系方式</h2>
      <div class="space-y-3">
        <p class="text-text-secondary group">
          <span class="text-text-primary">GitHub:</span>{' '}
          <a href="https://github.com/cancerlogo" target="_blank" rel="noopener noreferrer" class="link-underline text-accent">
            github.com/cancerlogo
          </a>
        </p>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  // Scroll Reveal Animation
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    },
    { threshold: 0.1 }
  );

  document.querySelectorAll('.reveal').forEach((el) => {
    observer.observe(el);
  });
</script>
