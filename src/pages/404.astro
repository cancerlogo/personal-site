---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 - 页面未找到">
  <div class="text-center py-20">
    <h1 class="text-6xl font-bold text-accent mb-4">404</h1>
    <p class="text-xl text-text-secondary mb-8">页面未找到</p>
    <p class="text-text-secondary mb-8">
      你访问的页面可能已被移除、更名，或暂时不可用。
    </p>
    <a href="/" class="px-6 py-3 rounded-full bg-accent text-bg-primary hover:opacity-90 transition-opacity">
      返回首页
    </a>
  </div>
</BaseLayout>
