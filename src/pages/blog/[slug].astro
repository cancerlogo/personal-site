---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const dateStr = post.data.pubDate.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

function getReadingTime(content: string): string {
  const chineseChars = (content.match(/[一-鿿]/g) || []).length;
  const englishWords = (content.match(/[a-zA-Z]+/g) || []).length;
  const minutes = Math.ceil(chineseChars / 400 + englishWords / 200);
  return `${minutes} 分钟`;
}
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="max-w-4xl mx-auto">
    {/* Post Header */}
    <header class="mb-8 pb-8 border-b border-border">
      <h1 class="text-3xl md:text-4xl font-bold mb-4">{post.data.title}</h1>
      <div class="flex flex-wrap items-center gap-3 text-sm text-text-secondary">
        <time datetime={post.data.pubDate.toISOString()}>{dateStr}</time>
        <span>·</span>
        <span>{getReadingTime(post.body || '')}</span>
        {post.data.category && (
          <>
            <span>·</span>
            <a href={`/blog/category/${post.data.category}`} class="text-accent hover:underline">
              {post.data.category}
            </a>
          </>
        )}
      </div>
      {post.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-4">
          {post.data.tags.map((tag) => (
            <a href={`/blog/tag/${tag}`} class="text-xs px-2 py-1 rounded bg-accent/10 text-accent hover:bg-accent/20 transition-colors">
              #{tag}
            </a>
          ))}
        </div>
      )}
    </header>

    {/* Table of Contents */}
    {headings.length > 0 && (
      <nav class="hidden xl:block fixed right-4 top-24 w-64 max-h-[calc(100vh-8rem)] overflow-y-auto">
        <p class="text-sm font-semibold text-text-primary mb-3">目录</p>
        <ul class="space-y-2">
          {headings.map((heading) => (
            <li style={`padding-left: ${(heading.depth - 2) * 1}rem`}>
              <a
                href={`#${heading.slug}`}
                class="block text-sm text-text-secondary hover:text-accent transition-colors"
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    {/* Post Content */}
    <div class="prose prose-lg">
      <Content />
    </div>

    {/* Post Footer */}
    <footer class="mt-12 pt-8 border-t border-border">
      {/* Prev/Next Navigation */}
      <div class="flex justify-between mb-8">
        <a href="/blog" class="text-accent hover:underline">← 返回博客列表</a>
      </div>

      {/* Comments */}
      <div class="mt-8">
        <h3 class="text-xl font-bold mb-4">评论</h3>
        <div class="giscus"></div>
        <script
          src="https://giscus.app/client.js"
          data-repo="cancerlogo/personal-site"
          data-repo-id="R_kgDOTF-vWQ"
          data-category="Announcements"
          data-category-id="DIC_kwDOTF-vWc4C_78w"
          data-mapping="pathname"
          data-strict="0"
          data-reactions-enabled="1"
          data-emit-metadata="0"
          data-input-position="bottom"
          data-theme="dark"
          data-lang="zh-CN"
          crossorigin="anonymous"
          async
        ></script>
      </div>
    </footer>
  </article>
</BaseLayout>

<script>
  // Active TOC tracking
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        const id = entry.target.getAttribute('id');
        const link = document.querySelector(`nav a[href="#${id}"]`);
        if (link) {
          if (entry.isIntersecting) {
            link.classList.add('text-accent');
            link.classList.remove('text-text-secondary');
          } else {
            link.classList.remove('text-accent');
            link.classList.add('text-text-secondary');
          }
        }
      });
    },
    { rootMargin: '-80px 0px -80% 0px' }
  );

  document.querySelectorAll('h2[id], h3[id]').forEach((heading) => {
    observer.observe(heading);
  });
</script>
